    {
      "parameters": {
        "promptType": "define",
        "text": "=Extract the candidate's details from this CV. Use ONLY what is written in the CV. Never guess or invent. If something is missing, write \"Not stated\" (or 0 for numbers).\n\nRules:\n- name: write it in normal case, like \"Ahmed Barakat\"\n- skills: every tool or skill with its years, like \"GoHighLevel (5 yrs); Zapier (4 yrs)\"\n- years_total: total years of work experience, as a number\n- us_hours: write \"yes\" ONLY if the CV literally says the person can work US hours (for example \"Available to work US Eastern hours\"). If the CV does not say it, write \"no\".\n- cv_date: the year this CV was written. If the file name contains a year, use it. Otherwise use the most recent year in the CV, and count \"Present\" as 2026.\n\nFile name: {{ $json.file_name }}\n\nCV:\n{{ $json.cv_text }}",
        "hasOutputParser": true,
        "batching": {}
      },
