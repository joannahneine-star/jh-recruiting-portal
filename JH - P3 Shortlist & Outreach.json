    {
      "parameters": {
        "jsCode": "const sh = $('Check and format').first().json;\nlet picked = ($input.first().json.data || {})['Candidates to contact'] || [];\nif (!Array.isArray(picked)) picked = [picked];\nconst pickedEmails = picked.map(p => String(p).split('|').pop().trim().toLowerCase());\n\n// For the Loom demo: put your Gmail here (e.g. 'joannahneine@gmail.com'), or leave '' for real emails\nconst DEMO_EMAIL = 'joannahneine@gmail.com';\n\nreturn sh.candidates.map(c => {\n  const [first, ...rest] = c.name.split(' ');\n  const approved = pickedEmails.includes(c.email.toLowerCase());\n  const ghl_email = DEMO_EMAIL ? DEMO_EMAIL.replace('@', '+' + first.toLowerCase() + '@') : c.email;\n  return { json: {\n    role_id: sh.role_id, role_title: sh.title,\n    candidate_email: c.email, name: c.name, first_name: first, last_name: rest.join(' '),\n    score: c.score, reason: c.reason, cv_file: c.cv_file,\n    approved: approved ? 'Yes' : 'No', ghl_email\n  }};\n});"
      },
