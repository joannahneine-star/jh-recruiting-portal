        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        320,
        272
      ],
      "id": "368f0da4-fe27-4df5-b28b-620bd4963bb1",
      "name": "Groq Chat Model",
      "credentials": {
        "groqApi": {
          "id": "GxImYDQwD5JOrxAg",
          "name": "JH-Groq"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a recruiting assistant. A recruiter asked: \"{{ $json.question }}\"\n\nHere is the ONLY list of candidates you may use ({{ $json.count }} people, one per line):\n{{ $json.list }}\n\nRules:\n1. Only choose people from this list. Never invent anyone.\n2. ONLY the lines under \"Must have\" are requirements. Responsibilities are NOT requirements. A candidate meets a must-have if their CV data shows it: years of experience = their total years in that role; a tool (e.g. Excel) = that tool appears in their skills. Skip must-haves a CV cannot show (tests, attitude, \"accuracy\"). \"Nice to have\" items and matching responsibilities only add points. Ignore anything \"Not specified\".\n3. \"GHL\" means GoHighLevel.\n4. Return at most 5 candidates, best first.\n5. Score each from 0 to 100: meets all requirements = 60 points, how far above the minimum = 25 points, total experience = 15 points. Two people should only get the same score if their facts are the same.\n6. reason = 2 short lines: line 1 = how they meet each requirement (with years), line 2 = one extra strength (a nice-to-have, total years, or US hours).\n7. If nobody meets all requirements, return an empty candidates list and explain why in \"message\".",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        384,
        112
      ],
      "id": "a68e15ee-0e1e-4740-a4ab-9f4413511153",
      "name": "Find top 5"
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output || {};\nconst rows = $('Get all candidates').all().map(i => i.json);\nconst byEmail = {};\nrows.forEach(r => byEmail[String(r.email).trim().toLowerCase()] = r);\nconst role = $('Build candidate list').first().json;\n\n// SAFETY: keep only real people, and take name + CV file from the Sheet\nconst real = (out.candidates || [])\n  .filter(c => byEmail[String(c.email).trim().toLowerCase()])\n  .slice(0, 5)\n  .map(c => {\n    const r = byEmail[String(c.email).trim().toLowerCase()];\n    return { email: r.email, name: r.name, score: c.score, reason: c.reason, cv_file: r.cv_file };\n  });\n\nlet message;\nif (real.length === 0) {\n  message = `❌ *No good match* for *${role.title}* (${role.role_id}).\\n${out.message || 'Nobody meets all the must-have requirements.'}`;\n} else {\n  message = `📋 *Shortlist for ${role.title}* (${role.role_id})\\n\\n` + real.map((c, i) =>\n    `*${i + 1}. ${c.name}*  –  score *${c.score}/100*\\n${c.reason}\\n📄 CV: ${c.cv_file}`\n  ).join('\\n\\n') + `\\n\\n👉 Choose who to contact in the form below.`;\n}\nreturn [{ json: { message, candidates: real, role_id: role.role_id, title: role.title } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
