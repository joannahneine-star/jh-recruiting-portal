    {
      "parameters": {
        "jsCode": "const role = $('Get role').first().json;\nconst question = `Find the best candidates for this job:\\n${role.job_description}`;\nconst rows = $input.all().map(i => i.json);\nconst list = rows.map(r =>\n  `${r.email} | ${r.name} | ${r.role} | ${r.location} | languages: ${r.languages} | skills: ${r.skills} | total years: ${r.years_total} | US hours: ${r.us_hours} | CV file: ${r.cv_file}`\n).join('\\n');\nreturn [{ json: { question, list, count: rows.length, role_id: role.role_id, title: role.title || role.role_id } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        96
      ],
      "id": "da063943-8d4d-439e-81a5-440fbb139a65",
      "name": "Build candidate list"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"message\": \"Found 3 candidates who match.\",\n  \"candidates\": [\n    {\n      \"email\": \"maya.haddad@example.com\",\n      \"name\": \"Maya Haddad\",\n      \"score\": 92,\n      \"reason\": \"5 years of GoHighLevel, above the 3-year minimum.\\nSpeaks Arabic and French.\"\n    }\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
